{
  "name": "flow",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:web": "bun run --filter web dev",
    "dev:api": "bun run --filter api dev",
    "lint": "bun run --filter '*' lint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "bun run --filter '*' typecheck",
    "prepare": "husky"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "vite": "^8.0.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "husky": "^9.1.7",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "hono": "4.12.18"
  }
}
